  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main next action in the workbook.",
      "html": "<button class=\"ds-primary\">Миссияны бастау</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:11px 18px;border:1px solid transparent;border-radius:9px;font:700 14px/1.5 Lab Sans,Arial,sans-serif;cursor:pointer;transition:background-color 160ms,transform 160ms cubic-bezier(.16,1,.3,1);background:var(--green,#b74711);color:#fff}@media(hover:hover) and (pointer:fine){.ds-primary:hover{background:var(--green-dark,#9e3d10)}}.ds-primary:focus-visible{outline:3px solid var(--focus,#7b91b7);outline-offset:4px}.ds-primary:active{transform:scale(.98)}.ds-primary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
